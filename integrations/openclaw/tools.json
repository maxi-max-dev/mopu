[
  {
    "name": "phone_status",
    "description": "Read connection, ownership, specific waiting reasons and capability availability. Does not read screen contents.",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    }
  },
  {
    "name": "phone_submit",
    "description": "Queue the phone part of your authorized task under your own agent identity. This does not dispatch to another agent.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "instruction": {
          "type": "string"
        },
        "required_milestones": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 20
        }
      },
      "required": [
        "title",
        "instruction"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "phone_wait",
    "description": "Wait up to 20 seconds for your next task and exclusive phone control. If waiting, stop phone actions and wait again when appropriate. After a new lease always observe before acting.",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    }
  },
  {
    "name": "phone_tools",
    "description": "Read actual device tool schemas and capability catalog under the lease. Catalog availability is not proof of task success.",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    }
  },
  {
    "name": "phone_call",
    "description": "Call a listed phone tool under the current lease. Observe before every input; use fresh coordinates, never refs. On any error observe again, never replay an uncertain input.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "arguments": {
          "type": "object",
          "default": {}
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "phone_step",
    "description": "Execute ONE authorized input with checkpoint and fresh readback. Requires a current screen observation ID. No input retries. Choose screenshot for custom editors/webviews; expected_text is only a substring diagnostic, not task verification.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "arguments": {
          "type": "object",
          "default": {}
        },
        "target": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "type": {
              "type": "string"
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "observation_id": {
          "type": "string"
        },
        "progress": {
          "type": "string"
        },
        "next_action": {
          "type": "string"
        },
        "observe": {
          "type": "string",
          "enum": [
            "text",
            "screenshot"
          ],
          "default": "text"
        },
        "expected_text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "settle_ms": {
          "type": "integer",
          "minimum": 400,
          "maximum": 5000,
          "default": 400,
          "description": "Bounded delay before first readback for lazy-loaded content; not proof of readiness. Input is never repeated."
        },
        "read_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3,
          "default": 1
        }
      },
      "required": [
        "name",
        "observation_id",
        "progress",
        "next_action"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "phone_milestone",
    "description": "Seal a completed workflow stage BEFORE switching apps. Requires fresh passed checks. Key is immutable; reuse identical key/checks only for acknowledgement recovery. Historical stage evidence never replaces final fresh readback.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "criterion": {
                "type": "string"
              },
              "observed": {
                "type": "string"
              },
              "observation_id": {
                "type": "string"
              },
              "passed": {
                "type": "boolean"
              }
            },
            "required": [
              "criterion",
              "observed",
              "observation_id",
              "passed"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 20
        }
      },
      "required": [
        "key",
        "checks"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "phone_checkpoint",
    "description": "Save completed progress and describe the next phone action so the user can understand and interrupt it.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "progress": {
          "type": "string"
        },
        "next_action": {
          "type": "string"
        },
        "wait_reason": {
          "type": "string",
          "enum": [
            "",
            "user_unlock",
            "user_decision",
            "external_service"
          ],
          "default": ""
        }
      },
      "required": [
        "progress",
        "next_action"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "phone_finish",
    "description": "Save results and release the phone. To mark verified, supply checks referring to broker-issued phone_harness_observation IDs from fresh reads after the last input. Otherwise the result is saved as unverified. Never use tool acknowledgements as proof. Store only minimal non-sensitive readbacks.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "result": {
          "type": "string"
        },
        "blocked": {
          "type": "boolean",
          "default": false
        },
        "required_milestones": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 20
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "criterion": {
                "type": "string"
              },
              "observed": {
                "type": "string"
              },
              "observation_id": {
                "type": "string"
              },
              "passed": {
                "type": "boolean"
              }
            },
            "required": [
              "criterion",
              "observed",
              "observation_id",
              "passed"
            ],
            "additionalProperties": false
          },
          "maxItems": 20
        },
        "unresolved": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 20
        }
      },
      "required": [
        "result"
      ],
      "additionalProperties": false
    }
  }
]
