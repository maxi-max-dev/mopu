[
  {
    "name": "phone_start",
    "description": "Start or renew ONE user-authorized whole task. Idle phone is selected atomically; no manual queue clicks. Supply the current user wording, unique authorization_id, total call and outgoing-attempt budgets. Reuse task_id to continue existing work. Repeating the same request returns its receipt, never reactivates revoked control. Then phone_wait and observe. Does not start an AI model.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "instruction": {
          "type": "string"
        },
        "task_id": {
          "type": "string"
        },
        "user_authorization": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "authorization_id": {
          "type": "string",
          "minLength": 8,
          "maxLength": 100
        },
        "max_calls": {
          "type": "integer",
          "minimum": 2,
          "maximum": 100000
        },
        "max_deliveries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "duration_seconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 86400,
          "default": 28800
        }
      },
      "required": [
        "user_authorization",
        "authorization_id",
        "max_calls",
        "max_deliveries"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "phone_session",
    "description": "Compact status for this client only: task IDs, progress, remaining budget, pending send and blocker. No screen contents or full historic queue.",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    }
  },
  {
    "name": "phone_heartbeat",
    "description": "Renew an existing valid lease without consuming task calls. Never grants control. Use while actively working, not to hold the phone for a stopped assistant.",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    }
  },
  {
    "name": "phone_status",
    "description": "Read connection, ownership, specific waiting reasons and capability availability. Does not read screen contents.",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    }
  },
  {
    "name": "phone_submit",
    "description": "Queue the phone part of your authorized task under your own agent identity. This does not dispatch to another agent.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "instruction": {
          "type": "string"
        },
        "required_milestones": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 20
        }
      },
      "required": [
        "title",
        "instruction"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "phone_request_control",
    "description": "Request control ONLY after a new direct user instruction in this conversation. Bind it to your own head task and fresh status generation. Supply the user wording and a unique authorization ID once; never automatically retry after human takeover. Then phone_wait and observe. This is an attestation by the trusted assistant, not independent proof of consent.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string"
        },
        "expected_generation": {
          "type": "integer",
          "minimum": 0
        },
        "user_authorization": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "authorization_id": {
          "type": "string",
          "minLength": 8,
          "maxLength": 100
        },
        "expected_head": {
          "type": "string"
        },
        "queue_switch_authorization": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      },
      "required": [
        "task_id",
        "expected_generation",
        "user_authorization",
        "authorization_id"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "phone_wait",
    "description": "Wait up to 20 seconds for your next task and exclusive phone control. If waiting, stop phone actions and wait again when appropriate. After a new lease always observe before acting.",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    }
  },
  {
    "name": "phone_tools",
    "description": "Read actual device tool schemas and capability catalog under the lease. Catalog availability is not proof of task success.",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    }
  },
  {
    "name": "phone_call",
    "description": "Call a listed phone tool under the current lease. Observe before every input; use fresh coordinates, never refs. On any error observe again, never replay an uncertain input.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "arguments": {
          "type": "object",
          "default": {}
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "phone_step",
    "description": "Execute ONE authorized input with checkpoint and fresh readback. Requires a current screen observation ID. No input retries. Choose screenshot for custom editors/webviews; expected_text is only a substring diagnostic, not task verification.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "arguments": {
          "type": "object",
          "default": {}
        },
        "target": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "type": {
              "type": "string"
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "observation_id": {
          "type": "string"
        },
        "progress": {
          "type": "string"
        },
        "next_action": {
          "type": "string"
        },
        "input_kind": {
          "type": "string",
          "enum": [
            "navigation",
            "send"
          ],
          "description": "Required for long tasks; accurately declare every outgoing send."
        },
        "delivery_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "description": "Stable destination key for each outgoing message. Required by the long-task workflow for sends; never replay a used key."
        },
        "observe": {
          "type": "string",
          "enum": [
            "text",
            "screenshot"
          ],
          "default": "text"
        },
        "expected_text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "settle_ms": {
          "type": "integer",
          "minimum": 400,
          "maximum": 5000,
          "default": 400,
          "description": "Bounded delay before first readback for lazy-loaded content; not proof of readiness. Input is never repeated."
        },
        "read_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3,
          "default": 1
        }
      },
      "required": [
        "name",
        "observation_id",
        "progress",
        "next_action"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "phone_delivery_confirm",
    "description": "Verify one pending outgoing message using fresh screen evidence after the send. No uncertain send may be replayed or counted. This records assistant judgment, not independent semantic proof.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string"
        },
        "outcome": {
          "type": "string",
          "enum": [
            "delivered",
            "not_sent"
          ]
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "criterion": {
                "type": "string"
              },
              "observed": {
                "type": "string"
              },
              "observation_id": {
                "type": "string"
              },
              "passed": {
                "type": "boolean"
              }
            },
            "required": [
              "criterion",
              "observed",
              "observation_id",
              "passed"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 20
        }
      },
      "required": [
        "key",
        "outcome",
        "checks"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "phone_milestone",
    "description": "Seal a completed workflow stage BEFORE switching apps. Requires fresh passed checks. Key is immutable; reuse identical key/checks only for acknowledgement recovery. Historical stage evidence never replaces final fresh readback.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "criterion": {
                "type": "string"
              },
              "observed": {
                "type": "string"
              },
              "observation_id": {
                "type": "string"
              },
              "passed": {
                "type": "boolean"
              }
            },
            "required": [
              "criterion",
              "observed",
              "observation_id",
              "passed"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 20
        }
      },
      "required": [
        "key",
        "checks"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "phone_checkpoint",
    "description": "Save completed progress and describe the next phone action so the user can understand and interrupt it.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "progress": {
          "type": "string"
        },
        "next_action": {
          "type": "string"
        },
        "wait_reason": {
          "type": "string",
          "enum": [
            "",
            "user_unlock",
            "user_decision",
            "external_service"
          ],
          "default": ""
        }
      },
      "required": [
        "progress",
        "next_action"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "phone_finish",
    "description": "Save results and release the phone. To mark verified, supply checks referring to broker-issued phone_harness_observation IDs from fresh reads after the last input. Otherwise the result is saved as unverified. Never use tool acknowledgements as proof. Store only minimal non-sensitive readbacks.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "result": {
          "type": "string"
        },
        "blocked": {
          "type": "boolean",
          "default": false
        },
        "required_milestones": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 20
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "criterion": {
                "type": "string"
              },
              "observed": {
                "type": "string"
              },
              "observation_id": {
                "type": "string"
              },
              "passed": {
                "type": "boolean"
              }
            },
            "required": [
              "criterion",
              "observed",
              "observation_id",
              "passed"
            ],
            "additionalProperties": false
          },
          "maxItems": 20
        },
        "unresolved": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 20
        }
      },
      "required": [
        "result"
      ],
      "additionalProperties": false
    }
  }
]
